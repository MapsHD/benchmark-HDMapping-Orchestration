# HDMapping's ROS-free bag converters: bag_to_laz, laz_to_bag, laz_to_mcap, mcap_to_laz.
# Built from HDMAPPING_REPO at HDMAPPING_REF, or from an HDMapping checkout placed in
# the build context as ./HDMapping (build_images.sh does that for HDMAPPING_SRC).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    git \
    wget \
    pkg-config \
    python3 \
    libeigen3-dev \
    libtbb-dev \
    liblaszip-dev \
    libproj-dev \
    proj-bin \
    libopencv-dev \
    libopencv-contrib-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    mesa-common-dev \
    xorg-dev \
    libx11-dev \
    libxi-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxxf86vm-dev \
    libglx-dev \
    libopengl-dev \
    libgl-dev \
    libglut-dev \
    liblz4-dev \
    libzstd-dev \
    libbz2-dev \
    && rm -rf /var/lib/apt/lists/*

RUN wget https://github.com/Kitware/CMake/releases/download/v4.0.0/cmake-4.0.0-linux-x86_64.sh && \
    chmod +x cmake-4.0.0-linux-x86_64.sh && \
    ./cmake-4.0.0-linux-x86_64.sh --prefix=/usr/local --skip-license && \
    rm cmake-4.0.0-linux-x86_64.sh

ARG HDMAPPING_REPO=https://github.com/MapsHD/HDMapping.git
ARG HDMAPPING_REF=canonical-bag

COPY . /workspace/context
RUN git config --global http.version HTTP/1.1 && \
    if [ -d /workspace/context/HDMapping ]; then \
        mv /workspace/context/HDMapping /workspace/HDMapping; \
    else \
        git clone --recursive --branch "$HDMAPPING_REF" "$HDMAPPING_REPO" /workspace/HDMapping; \
    fi && \
    rm -rf /workspace/context

WORKDIR /workspace/HDMapping

RUN cmake -S . -B build -DBUILD_WITH_CLI_TOOLS=ON && \
    cmake --build build --target bag_to_laz laz_to_bag laz_to_mcap mcap_to_laz -j$(nproc) && \
    install -m 755 build/bin/bag_to_laz build/bin/laz_to_bag build/bin/laz_to_mcap build/bin/mcap_to_laz /usr/local/bin/ && \
    if [ -f .hdmapping-version ]; then cp .hdmapping-version /usr/local/share/hdmapping-version; \
    else git log -1 --format='HDMapping %h %s' > /usr/local/share/hdmapping-version; fi

WORKDIR /data
CMD ["bash"]
